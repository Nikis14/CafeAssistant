# Copy to .env and fill in.

# ── Models ───────────────────────────────────────────────────────────────────
# Main provider (OpenAI-compatible): https://neuraldeep.tech
NEURAL_DEEP_API_KEY=
# Extra keys are optional: the "gateway" model load-balances over all of them.
NEURAL_DEEP_API_KEY_2=
# Optional backup provider: the "gateway" model falls back to OpenAI when NeuralDeep fails.
OPENAI_API_KEY=
# Default model id: neuraldeep/<model>, openai/<model> or gateway
TASTE_AGENT_MODEL_ID=neuraldeep/qwen3.6-35b-a3b-noreason

# ── Observability: LangSmith ─────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=taste-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── External data (optional) ─────────────────────────────────────────────────
# Without these keys set TASTE_AGENT_ALLOW_RUNTIME_MOCKS=1: places come from a
# built-in Belgrade dataset and booking runs against a mock browser.
TAVILY_API_KEY=
FOURSQUARE_API_KEY=
TASTE_AGENT_ALLOW_RUNTIME_MOCKS=1

# ── Cost switches ────────────────────────────────────────────────────────────
# Output-guardrail LLM judge: off unless a judge model is set.
TASTE_AGENT_JUDGE_MODEL_ID=
# Memory reflection sub-agent: off by default (one extra LLM call per turn).
TASTE_AGENT_SKIP_REFLECTION=1

# "1" skips the sentence-transformers download for episodic memory.
TASTE_AGENT_FAKE_EMBEDDING=
TASTE_AGENT_BROWSER_POOL_SIZE=3
